// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model VaultEntry {
  id        String   @id @default(cuid())
  title     String
  tool      String
  content   String
  severity  String
  timestamp BigInt
}

